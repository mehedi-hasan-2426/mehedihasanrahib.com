---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
---

<Base title={`${p.name} | Mehedi Hasan Rahib`} description={p.summary}>
  <article class="project">
    <p>
      <a href="/#work">Back to all work</a>
    </p>
    <p class="badge" data-tone={p.status === "Live" ? "live" : p.status === "Work in progress" ? "wip" : "learning"}>
      {p.status}
    </p>
    <h1>{p.name}</h1>
    <p class="lede">{p.summary}</p>
    <p class="links">
      {p.live && (
        <a class="btn" href={p.live} rel="noopener">
          Live demo
        </a>
      )}
      <a class={p.live ? "btn ghost" : "btn"} href={p.repo} rel="noopener">
        GitHub
      </a>
    </p>
    {p.image && (
      <figure class="shot">
        <img src={p.image} alt={p.imageAlt ?? ""} width={p.imageWidth} height={p.imageHeight} decoding="async" />
      </figure>
    )}
    {p.architecture && (
      <section aria-labelledby="arch">
        <h2 id="arch">Architecture</h2>
        <ol class="flow">
          {p.architecture.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
      </section>
    )}
    <div class="prose-body">
      <Content />
    </div>
    <ul class="tags mt-6" aria-label="Stack">
      {p.stack.map((s) => (
        <li>{s}</li>
      ))}
    </ul>
  </article>
</Base>
