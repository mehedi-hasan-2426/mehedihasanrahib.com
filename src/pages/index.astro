---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import GitHubTile from "../components/GitHubTile.tsx";
import Icon from "../components/Icon.astro";
import { education, experience, languages, learning, skills } from "../cv.ts";
const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = all.slice(0, 3);
const more = all.slice(3);
---

<Base>
  <link slot="head" rel="preload" as="image" href="/hero-bg.avif" type="image/avif" fetchpriority="high" />
  <div slot="backdrop" class="backdrop" aria-hidden="true"></div>
  <section class="intro">
    <h1>Mehedi Hasan Rahib</h1>
    <p class="role">Application developer apprentice, cloud and DevOps</p>
    <p class="lede">
      I build infrastructure with Terraform on AWS, CI pipelines with security checks, and small tested apps.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#work">
        Explore my projects
      </a>
      <a class="btn ghost" href="#contact">
        Let's connect
      </a>
      <a class="icon-link" href="https://github.com/mehedi-hasan-2426" rel="noopener" aria-label="GitHub profile">
        <Icon name="github" />
      </a>
    </div>
  </section>

  <section id="about" aria-labelledby="about-title" class="reveal">
    <h2 id="about-title" class="section-title">
      About
    </h2>
    <div class="about-text">
      <p>
        After the Studienkolleg at Hochschule Anhalt I studied biotechnology at Hochschule Niederrhein from 2021 to
        2023, then moved into IT. Since November 2024 I have been training as an application developer in a cloud
        platform team at RWE Supply &amp; Trading in Essen.
      </p>
      <p>
        At work I write Terraform for AWS, maintain Azure DevOps pipelines, add security scanning and automate server
        patching. Outside work I build small, tested projects to practise what my job does not cover yet, from a German
        learning app to a patch compliance reporter.
      </p>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-title" class="reveal">
    <h2 id="skills-title" class="section-title">
      Tech stack
    </h2>
    <div class="skill-groups">
      {skills.map((s) => (
        <div>
          <h3>{s.group}</h3>
          <ul class="tags">
            {s.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <h3>Spoken languages</h3>
        <p>{languages.join(", ")}</p>
      </div>
    </div>
  </section>

  <section id="work" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">
      Projects
    </h2>
    <div class="grid">
      {featured.map((p) => (
        <article class="card">
          <p class="status">{p.data.status}</p>
          <h3>
            <a href={`/projects/${p.id}`}>{p.data.name}</a>
          </h3>
          <p>{p.data.summary}</p>
          <p class="stack">{p.data.stack.join(", ")}</p>
        </article>
      ))}
    </div>
    {more.length > 0 && (
      <ul class="more-projects" aria-label="More projects">
        {more.map((p) => (
          <li>
            <a href={`/projects/${p.id}`}>{p.data.name}</a>
            <span>{p.data.summary}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="experience" aria-labelledby="experience-title" class="reveal">
    <h2 id="experience-title" class="section-title">
      Experience
    </h2>
    <ol class="timeline">
      {experience.map((t) => (
        <li>
          <p class="when">{t.when}</p>
          <h3>{t.title}</h3>
          <p class="place">{t.place}</p>
          <p>{t.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="education" aria-labelledby="education-title" class="reveal">
    <h2 id="education-title" class="section-title">
      Education
    </h2>
    <ol class="timeline">
      {education.map((t) => (
        <li>
          <p class="when">{t.when}</p>
          <h3>{t.title}</h3>
          <p class="place">{t.place}</p>
          {t.text && <p>{t.text}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section id="learning" aria-labelledby="learning-title" class="reveal">
    <h2 id="learning-title" class="section-title">
      Currently learning
    </h2>
    <ul class="learning-list">
      {learning.map((l) => (
        <li>
          <h3>{l.title}</h3>
          <p>{l.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" aria-labelledby="contact-title" class="contact">
    <h2 id="contact-title" class="section-title">
      Contact
    </h2>
    <p>Open to junior cloud, DevOps and developer roles after my Ausbildung in 2027.</p>
    <ul class="social" aria-label="Contact profiles">
      <li>
        <a class="icon-link" href="https://github.com/mehedi-hasan-2426" rel="noopener" aria-label="GitHub profile">
          <Icon name="github" />
        </a>
      </li>
    </ul>
    <div class="github">
      <GitHubTile client:visible />
    </div>
  </section>
</Base>
