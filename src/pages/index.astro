---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import GitHubTile from "../components/GitHubTile.tsx";
import Icon from "../components/Icon.astro";
import { education, experience, languages, learning, skills } from "../cv.ts";
const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const more = all.filter((p) => !p.data.featured);
---

<Base>
  <link slot="head" rel="preload" as="image" href="/hero-bg.avif" type="image/avif" fetchpriority="high" />
  <div slot="backdrop" class="backdrop" aria-hidden="true"></div>

  <section class="intro">
    <p class="availability">
      <span class="dot" aria-hidden="true"></span>Open to junior roles from 2027
    </p>
    <h1>Mehedi Hasan Rahib</h1>
    <p class="role">Software developer growing into cloud and DevOps engineering.</p>
    <p class="lede">
      Completing my apprenticeship in application development. Exploring software, cloud infrastructure and automation
      through practical projects.
    </p>
    <div class="hero-actions">
      <a class="btn" href="#work">
        Explore my projects
      </a>
      <a class="btn ghost" href="#contact">
        Let's connect
      </a>
      <a class="icon-link" href="https://github.com/mehedi-hasan-2426" rel="noopener" aria-label="GitHub profile">
        <Icon name="github" />
      </a>
    </div>
  </section>

  <section id="work" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">
      Projects
    </h2>
    <div class="featured-list">
      {featured.map((p) => (
        <FeaturedProject project={p} />
      ))}
    </div>
    <h3 class="subsection-title">Smaller tools and work in progress</h3>
    <ul class="minor-list">
      {more.map((p) => (
        <li class="minor-project">
          <div class="minor-head">
            <a class="minor-name" href={`/projects/${p.id}`}>
              {p.data.name}
            </a>
            <span class="badge" data-tone={p.data.status === "Work in progress" ? "wip" : "learning"}>
              {p.data.status}
            </span>
          </div>
          <p>{p.data.summary}</p>
          <p class="stack">{p.data.stack.join(", ")}</p>
          <a class="text-link" href={p.data.repo} rel="noopener">
            GitHub
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="about" aria-labelledby="about-title" class="reveal">
    <h2 id="about-title" class="section-title">
      About
    </h2>
    <div class="about-text">
      <p>
        I'm completing an apprenticeship in application development at RWE Supply &amp; Trading in Essen, expected to
        finish in 2027. Before moving into IT, I studied biotechnology.
      </p>
      <p>
        My interests span software development, cloud infrastructure and automation. My personal projects include web
        applications and tools for reporting and deployment.
      </p>
    </div>
  </section>

  <section id="skills" aria-labelledby="skills-title" class="reveal">
    <h2 id="skills-title" class="section-title">
      Tech stack
    </h2>
    <p class="legend">
      <span class="tag-sample" data-use="work">
        Professional experience
      </span>{" "}
      tools I use in my job
      <span class="tag-sample" data-use="projects">
        Projects and coursework
      </span>{" "}
      tools I use in personal projects and studies
    </p>
    <div class="skill-groups">
      {skills.map((s) => (
        <div>
          <h3>{s.group}</h3>
          <ul class="tags">
            {s.items.map((i) => (
              <li data-use={i.use}>{i.name}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="spoken">Spoken languages: {languages.join(", ")}</p>
  </section>

  <section id="experience" aria-labelledby="experience-title" class="reveal">
    <h2 id="experience-title" class="section-title">
      Experience
    </h2>
    <ol class="timeline">
      {experience.map((t) => (
        <li>
          <p class="when">{t.when}</p>
          <div>
            <h3>{t.title}</h3>
            <p class="place">{t.place}</p>
            <p>{t.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="education" aria-labelledby="education-title" class="reveal">
    <h2 id="education-title" class="section-title">
      Education
    </h2>
    <ol class="timeline">
      {education.map((t) => (
        <li>
          <p class="when">{t.when}</p>
          <div>
            <h3>{t.title}</h3>
            <p class="place">{t.place}</p>
            {t.text && <p>{t.text}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="learning" aria-labelledby="learning-title" class="reveal">
    <h2 id="learning-title" class="section-title">
      Currently learning
    </h2>
    <ul class="learning-list">
      {learning.map((l) => (
        <li>
          <h3>{l.title}</h3>
          <p>{l.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section id="contact" aria-labelledby="contact-title" class="contact">
    <h2 id="contact-title" class="section-title">
      Contact
    </h2>
    <p>
      Open to junior cloud, DevOps and developer roles after my Ausbildung in 2027. GitHub is the best place to see my
      work.
    </p>
    <ul class="social" aria-label="Contact profiles">
      <li>
        <a class="icon-link" href="https://github.com/mehedi-hasan-2426" rel="noopener" aria-label="GitHub profile">
          <Icon name="github" />
        </a>
      </li>
    </ul>
    <div class="github">
      <GitHubTile client:visible />
    </div>
  </section>
</Base>
