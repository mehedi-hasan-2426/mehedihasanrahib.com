---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import GitHubTile from "../components/GitHubTile.tsx";
import Icon from "../components/Icon.astro";
import { education, experience, languages, skills } from "../cv.ts";
const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = all.slice(0, 3);
const more = all.slice(3);
---

<Base>
  <section class="intro">
    <h1>Mehedi Hasan Rahib</h1>
    <p class="lede">
      Apprentice application developer in Essen, working in a cloud platform team. I build infrastructure with Terraform
      on AWS, CI pipelines with security checks, and small apps that people use.
    </p>
    <ul class="social" aria-label="Profiles">
      <li>
        <a class="social-link" href="https://github.com/mehedi-hasan-2426" rel="noopener">
          <Icon name="github" />
          <span>GitHub</span>
        </a>
      </li>
      <li>
        <span class="social-link static">
          <Icon name="linkedin" />
          <span>LinkedIn: Mehedi Hasan Rahib</span>
        </span>
      </li>
    </ul>
  </section>

  <section id="work" aria-labelledby="work-title">
    <h2 id="work-title" class="section-title">
      Projects
    </h2>
    <div class="grid">
      {featured.map((p) => (
        <article class="card">
          <p class="status">{p.data.status}</p>
          <h3>
            <a href={`/projects/${p.id}`}>{p.data.name}</a>
          </h3>
          <p>{p.data.summary}</p>
          <p class="stack">{p.data.stack.join(", ")}</p>
        </article>
      ))}
    </div>
    {more.length > 0 && (
      <ul class="more-projects" aria-label="More projects">
        {more.map((p) => (
          <li>
            <a href={`/projects/${p.id}`}>{p.data.name}</a>
            <span>{p.data.summary}</span>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section id="experience" aria-labelledby="experience-title">
    <h2 id="experience-title" class="section-title">
      Experience
    </h2>
    <ol class="timeline">
      {experience.map((t) => (
        <li>
          <p class="when">{t.when}</p>
          <h3>{t.title}</h3>
          <p class="place">{t.place}</p>
          <p>{t.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="education" aria-labelledby="education-title">
    <h2 id="education-title" class="section-title">
      Education
    </h2>
    <ol class="timeline">
      {education.map((t) => (
        <li>
          <p class="when">{t.when}</p>
          <h3>{t.title}</h3>
          <p class="place">{t.place}</p>
          {t.text && <p>{t.text}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section id="skills" aria-labelledby="skills-title">
    <h2 id="skills-title" class="section-title">
      Skills
    </h2>
    <div class="skill-groups">
      {skills.map((s) => (
        <div>
          <h3>{s.group}</h3>
          <ul class="tags">
            {s.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <h3>Spoken languages</h3>
        <p>{languages.join(", ")}</p>
      </div>
    </div>
  </section>

  <section id="contact" aria-labelledby="contact-title" class="contact">
    <h2 id="contact-title" class="section-title">
      Contact
    </h2>
    <p>Open to junior cloud, DevOps and developer roles after my Ausbildung in 2027.</p>
    <div class="github">
      <GitHubTile client:visible />
    </div>
  </section>
</Base>
