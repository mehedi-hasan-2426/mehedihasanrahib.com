---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Mehedi Hasan Rahib | Software developer, cloud and DevOps",
  description = "Mehedi Hasan Rahib, apprentice application developer in Essen. Cloud, DevOps and web projects with Terraform, AWS, Python and TypeScript.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080D1A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dark navy cloud infrastructure illustration" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot name="backdrop" />
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="top">
      <a class="mark" href="/" aria-label="Home">
        MHR
      </a>
      <nav aria-label="Main">
        <a href="/#work">Projects</a>
        <a href="/#about">About</a>
        <a href="/#experience">Experience</a>
        <a href="/#contact">Contact</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p>&copy; 2026 Mehedi Hasan Rahib</p>
      <p>
        <a href="https://github.com/mehedi-hasan-2426/mehedihasanrahib.de" rel="noopener">
          Source of this site
        </a>
      </p>
    </footer>
  </body>
</html>
